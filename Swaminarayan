  document.getElementById('sPBar').style.width='100%';
  document.getElementById('sps2').classList.add('active');
  document.getElementById('spl1').style.width='100%';
}
function sPrev() {
  document.getElementById('sS2').classList.remove('active');
  document.getElementById('sS1').classList.add('active');
  document.getElementById('sPBar').style.width='50%';
  document.getElementById('sps2').classList.remove('active','done');
  document.getElementById('spl1').style.width='0%';
}
function sSubmit() {
