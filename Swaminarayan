<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<title>Swaminarayan University — Start in India. Graduate Abroad. | College Assist For You</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
:root{
  --navy:#050D2E;--blue:#1847C2;--blue2:#2C5FE4;--purple:#6C3DE8;
  --orange:#FF5722;--gold:#FFB800;--green:#10D979;
  --off:#F5F7FF;--muted:#64748B;--border:#E2E8F0;
}
body{font-family:'Inter',sans-serif;background:#fff;color:var(--navy);overflow-x:hidden}

/* ── WA FLOAT ── */
.wa-float{position:fixed;bottom:90px;right:18px;z-index:9999;width:54px;height:54px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.5);text-decoration:none;animation:wap 2.5s infinite}
.wa-float svg{width:26px;height:26px;fill:#fff}
@keyframes wap{0%,100%{box-shadow:0 4px 20px rgba(37,211,102,.5)}50%{box-shadow:0 4px 32px rgba(37,211,102,.8),0 0 0 8px rgba(37,211,102,.12)}}

/* ── URGENCY BAR ── */
.ubar{background:linear-gradient(90deg,#050D2E,#1847C2,#6C3DE8,#1847C2,#050D2E);background-size:300%;animation:uslide 5s linear infinite;color:#fff;padding:10px 16px;text-align:center;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;position:sticky;top:0;z-index:1000}
@keyframes uslide{0%{background-position:0%}100%{background-position:300%}}
.ubar-tag{background:var(--orange);padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase}
.ubar a{color:var(--gold);text-decoration:none;font-weight:700;border-bottom:1px solid rgba(255,179,0,.3)}
.ldot{width:7px;height:7px;background:#4ADE80;border-radius:50%;animation:blink 1.2s infinite;flex-shrink:0}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

/* ── NAV ── */
.nav{background:#fff;border-bottom:1px solid var(--border);padding:0 5vw;height:68px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:40px;z-index:999;box-shadow:0 2px 16px rgba(5,13,46,.06)}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.nav-logo img{height:48px;width:auto;object-fit:contain}
.nav-back{font-size:13px;color:var(--muted);text-decoration:none;display:flex;align-items:center;gap:5px}
.nav-back:hover{color:var(--blue)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--orange),#E64A19);color:#fff;border:none;border-radius:100px;padding:9px 20px;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none;box-shadow:0 4px 14px rgba(255,87,34,.3);animation:pbtn 2.5s infinite;font-family:'Inter',sans-serif}
@keyframes pbtn{0%,100%{box-shadow:0 4px 14px rgba(255,87,34,.3)}50%{box-shadow:0 6px 24px rgba(255,87,34,.6)}}

/* ── HERO ── */
.hero{min-height:100vh;background-color:#050D2E;background-image:linear-gradient(135deg,#050D2E 0%,#0f2460 40%,#1847C2 70%,#6C3DE8 100%);position:relative;display:flex;align-items:center;padding:80px 5vw}
.hero-grid-bg{position:absolute;top:0;left:0;right:0;bottom:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:60px 60px;pointer-events:none}
.hero-inner{max-width:1280px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 440px;align-items:center;gap:60px;position:relative;z-index:2}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:100px;padding:6px 16px;color:#fff;font-size:12.5px;font-weight:600;margin-bottom:20px;letter-spacing:.02em}
.hero-h1{font-family:'Sora',sans-serif;font-size:clamp(34px,4.5vw,62px);font-weight:900;color:#fff;line-height:1.08;letter-spacing:-.03em;margin-bottom:10px}
.hero-h1 .gold{color:var(--gold)}
.hero-h1 .green{color:var(--green)}
.hero-h2{font-family:'Sora',sans-serif;font-size:clamp(16px,1.8vw,22px);font-weight:600;color:rgba(255,255,255,.75);margin-bottom:18px;line-height:1.4}
.hero-desc{font-size:15px;color:rgba(255,255,255,.65);line-height:1.75;margin-bottom:28px;max-width:520px}
.hero-usps{list-style:none;margin-bottom:32px;display:flex;flex-direction:column;gap:10px}
.hero-usp{display:flex;align-items:center;gap:10px;font-size:14px;color:rgba(255,255,255,.85);font-weight:500}
.hero-usp-icon{width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.hero-ctas{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:none;border-radius:12px;font-family:'Inter',sans-serif;font-weight:700;cursor:pointer;transition:all .25s;text-decoration:none;white-space:nowrap}
.btn-primary{background:linear-gradient(135deg,var(--orange),#E64A19);color:#fff;padding:15px 28px;font-size:15px;box-shadow:0 4px 20px rgba(255,87,34,.4)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(255,87,34,.6)}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:14px 24px;font-size:14px}
.btn-ghost:hover{background:rgba(255,255,255,.2)}
.btn-wa{background:#25D366;color:#fff;padding:14px 24px;font-size:14px;box-shadow:0 4px 14px rgba(37,211,102,.3)}
.btn-wa:hover{background:#1ebe5d;transform:translateY(-2px)}
.btn-orange{background:linear-gradient(135deg,var(--orange),#E64A19);color:#fff;padding:15px;font-size:15px;font-weight:700;border:none;border-radius:12px;cursor:pointer;font-family:'Inter',sans-serif;box-shadow:0 4px 16px rgba(255,87,34,.4);animation:pbtn 2.5s infinite;width:100%;margin-bottom:10px}
.btn-orange:hover{transform:translateY(-1px)}

/* ── HERO FORM ── */
.hero-form{background:#fff;border-radius:24px;padding:28px 26px;box-shadow:0 32px 80px rgba(0,0,0,.3);position:relative;overflow:hidden}
.hero-form::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--purple),var(--blue2),var(--orange))}
.form-badge{display:flex;align-items:center;gap:7px;background:rgba(255,87,34,.08);border:1px solid rgba(255,87,34,.2);border-radius:100px;padding:5px 14px;font-size:12px;font-weight:700;color:var(--orange);margin-bottom:14px;width:fit-content}
.form-h{font-family:'Sora',sans-serif;font-size:18px;font-weight:900;color:var(--navy);margin-bottom:5px;line-height:1.25}
.form-sub{font-size:12.5px;color:var(--muted);margin-bottom:16px;line-height:1.5}
.scarcity{display:flex;align-items:center;gap:7px;background:#FFF0F0;border:1px solid #FFCDD2;border-radius:8px;padding:7px 12px;font-size:12px;font-weight:700;color:#C62828;margin-bottom:15px;animation:sc 2s ease-in-out infinite}
@keyframes sc{0%,100%{opacity:1}50%{opacity:.75}}
.prog-wrap{margin-bottom:15px}
.prog-steps{display:flex;align-items:center;margin-bottom:7px}
.prog-step{display:flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:#CBD5E1;transition:color .3s}
.prog-step.active{color:var(--blue)}
.prog-step.done{color:var(--green)}
.prog-dot{width:20px;height:20px;border-radius:50%;background:#E2E8F0;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--muted);transition:all .3s;flex-shrink:0}
.prog-step.active .prog-dot{background:var(--blue);color:#fff}
.prog-step.done .prog-dot{background:var(--green);color:#fff}
.prog-line{flex:1;height:2px;background:#E2E8F0;margin:0 4px;border-radius:2px;overflow:hidden}
.prog-line-fill{height:100%;background:var(--blue);width:0%;transition:width .4s ease}
.prog-bar{height:5px;background:#E2E8F0;border-radius:3px;overflow:hidden}
.prog-bar-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--purple));border-radius:3px;transition:width .5s ease}
.fgroup{margin-bottom:11px}
.fgroup label{display:block;font-size:12px;font-weight:600;color:var(--navy);margin-bottom:4px}
.fgroup input,.fgroup select{width:100%;padding:11px 14px;border:1.5px solid #E2E8F0;border-radius:10px;font-size:15px;font-family:'Inter',sans-serif;color:var(--navy);background:#fff;outline:none;transition:border-color .2s;-webkit-appearance:none}
.fgroup input:focus,.fgroup select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(24,71,194,.08)}
.fgroup input.err,.fgroup select.err{border-color:#EF5350}
.fgroup input::placeholder{color:#CBD5E1}
.f-step{display:none}
.f-step.active{display:block;animation:slin .3s ease}
@keyframes slin{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:translateX(0)}}
.f-nav{display:flex;gap:10px}
.f-back{background:none;border:1.5px solid #E2E8F0;color:var(--muted);border-radius:10px;padding:10px 14px;font-size:13px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;flex-shrink:0}
.f-back:hover{border-color:var(--blue);color:var(--blue)}
.f-trust{text-align:center;font-size:11px;color:var(--muted);margin-top:8px}
.f-ok{display:none;text-align:center;padding:12px 0;animation:slin .35s ease}
.f-ok-icon{font-size:44px;margin-bottom:10px}
.f-ok-h{font-family:'Sora',sans-serif;font-size:18px;font-weight:900;color:var(--navy);margin-bottom:6px}
.f-ok-p{font-size:13px;color:var(--muted);line-height:1.65}
.wa-btn-form{display:flex;align-items:center;justify-content:center;gap:8px;background:#25D366;color:#fff;text-decoration:none;border-radius:10px;padding:12px;font-size:14px;font-weight:700;margin-top:12px;box-shadow:0 4px 12px rgba(37,211,102,.3)}

/* ── STATS BAR ── */
.stats-bar{background:#fff;border-bottom:1px solid var(--border);padding:20px 5vw}
.stats-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-around;flex-wrap:wrap;gap:20px}
.stat-item{text-align:center}
.stat-num{font-family:'Sora',sans-serif;font-size:28px;font-weight:900;color:var(--blue);display:block}
.stat-lbl{font-size:12px;color:var(--muted);font-weight:500;margin-top:2px}
.stat-sep{width:1px;height:40px;background:var(--border)}

/* ── SECTIONS ── */
section{padding:80px 5vw}
.sec-inner{max-width:1240px;margin:0 auto}
.sec-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(108,61,232,.07);border:1px solid rgba(108,61,232,.18);border-radius:100px;padding:5px 16px;font-size:12px;font-weight:700;color:var(--purple);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}
.sec-h{font-family:'Sora',sans-serif;font-size:clamp(26px,3.5vw,44px);font-weight:900;color:var(--navy);line-height:1.12;margin-bottom:14px;letter-spacing:-.02em}
.sec-h .acc{color:var(--blue)}
.sec-h .acc-o{color:var(--orange)}
.sec-h .acc-g{color:var(--green)}
.sec-sub{font-size:16px;color:var(--muted);line-height:1.75;max-width:640px}
.sec-header{text-align:center;margin-bottom:52px}
.sec-header .sec-sub{margin:0 auto}

/* ── HOW IT WORKS ── */
.how-sec{background:var(--off)}
.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;position:relative}
.how-grid::before{content:'';position:absolute;top:60px;left:16.5%;right:16.5%;height:2px;background:linear-gradient(90deg,var(--purple),var(--blue2),var(--green));z-index:0}
.how-step{padding:44px 28px;text-align:center;position:relative;z-index:1}
.how-circle{width:88px;height:88px;border-radius:50%;background:linear-gradient(135deg,var(--purple),var(--blue2));display:flex;align-items:center;justify-content:center;margin:0 auto 20px;box-shadow:0 8px 28px rgba(108,61,232,.35);border:4px solid #fff;position:relative}
.how-circle-emoji{font-size:34px;line-height:1;display:block}
.how-badge{position:absolute;top:-6px;right:-6px;width:26px;height:26px;border-radius:50%;background:var(--orange);color:#fff;font-size:12px;font-weight:900;display:flex;align-items:center;justify-content:center;border:2px solid #fff;font-family:'Sora',sans-serif}
.how-title{font-family:'Sora',sans-serif;font-size:17px;font-weight:800;color:var(--navy);margin-bottom:8px}
.how-desc{font-size:13.5px;color:var(--muted);line-height:1.7}
.how-label{display:inline-block;background:linear-gradient(135deg,var(--purple),var(--blue2));color:#fff;border-radius:100px;padding:4px 14px;font-size:11px;font-weight:700;margin-bottom:14px;letter-spacing:.04em}


.cost-banner span{font-size:24px}

/* ── GALLERY ── */
.gallery-sec{background:var(--off)}
.gallery-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;justify-content:center}
.gtab{padding:9px 22px;border-radius:100px;border:1.5px solid var(--border);background:#fff;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;transition:all .2s;font-family:'Inter',sans-serif}
.gtab:hover{border-color:var(--blue);color:var(--blue)}
.gtab.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.gallery-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.g-item{border-radius:14px;overflow:hidden;aspect-ratio:4/3;position:relative;cursor:pointer;box-shadow:0 2px 12px rgba(5,13,46,.08)}
.g-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.g-item:hover img{transform:scale(1.06)}
.g-item-label{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(0deg,rgba(5,13,46,.8),transparent);color:#fff;padding:16px 12px 10px;font-size:12px;font-weight:600;opacity:0;transition:opacity .3s}
.g-item:hover .g-item-label{opacity:1}
.g-item.hidden{display:none}

/* ── INFRA FEATURES ── */
.infra-sec{background:#fff}
.infra-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:32px}
.infra-card{border-radius:20px;overflow:hidden;border:1.5px solid var(--border);transition:all .3s;box-shadow:0 2px 12px rgba(5,13,46,.06)}
.infra-card:hover{transform:translateY(-5px);box-shadow:0 16px 48px rgba(5,13,46,.13);border-color:transparent}
.infra-card-img{height:240px;overflow:hidden}
.infra-card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.infra-card:hover .infra-card-img img{transform:scale(1.05)}
.infra-card-body{padding:22px 24px}
.infra-card-icon{font-size:28px;margin-bottom:10px}
.infra-card-title{font-family:'Sora',sans-serif;font-size:17px;font-weight:800;color:var(--navy);margin-bottom:6px}
.infra-card-desc{font-size:13.5px;color:var(--muted);line-height:1.7}

/* ── TRUST STATS ── */
.trust-sec{background-color:#1847C2;background-image:linear-gradient(135deg,#050D2E,#1847C2,#6C3DE8);position:relative}
.trust-inner{max-width:1100px;margin:0 auto;text-align:center;position:relative;z-index:2}
.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:40px}
.trust-card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:28px 20px;transition:all .3s}
.trust-card:hover{background:rgba(255,255,255,.12);transform:translateY(-4px)}
.trust-card-num{font-family:'Sora',sans-serif;font-size:38px;font-weight:900;color:var(--gold);display:block;margin-bottom:6px}
.trust-card-lbl{font-size:14px;font-weight:600;color:#fff;margin-bottom:4px;font-family:'Sora',sans-serif}
.trust-card-sub{font-size:12px;color:rgba(255,255,255,.5)}

/* ── NIGHT CTA ── */
.night-cta{position:relative;overflow:hidden;min-height:480px;display:flex;align-items:center;justify-content:center}
.night-cta-bg{position:absolute;top:0;left:0;right:0;bottom:0}
.night-cta-bg img{width:100%;height:100%;object-fit:cover;display:block}
.night-cta-overlay{position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(5,13,46,.78)}
.night-cta-content{position:relative;z-index:2;text-align:center;padding:60px 5vw;max-width:700px;margin:0 auto}
.night-cta h2{font-family:'Sora',sans-serif;font-size:clamp(28px,4vw,50px);font-weight:900;color:#fff;line-height:1.1;margin-bottom:14px;letter-spacing:-.02em}
.night-cta p{font-size:16px;color:rgba(255,255,255,.72);margin-bottom:32px;line-height:1.65}
.night-cta-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

/* ── STICKY BAR ── */
.sticky-bar{display:none;position:fixed;bottom:0;left:0;right:0;background:var(--navy);border-top:2px solid var(--orange);padding:10px 14px;z-index:8888;justify-content:center;align-items:center;gap:8px}
.sticky-bar a,.sticky-bar button{flex:1;max-width:160px;text-align:center;padding:11px 8px;border-radius:10px;font-size:13px;font-weight:700;border:none;cursor:pointer;font-family:'Inter',sans-serif;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:5px}
.sb-orange{background:linear-gradient(135deg,var(--orange),#E64A19);color:#fff}
.sb-green{background:#25D366;color:#fff}
.sb-blue{background:var(--blue);color:#fff}

/* ── FOOTER ── */
.footer{background:var(--navy);padding:40px 5vw 20px;text-align:center}
.footer-logo{height:48px;width:auto;object-fit:contain;margin-bottom:14px;filter:brightness(0) invert(1)}
.footer-tagline{font-size:13px;color:rgba(255,255,255,.4);margin-bottom:20px;line-height:1.6}
.footer-links{display:flex;justify-content:center;gap:20px;flex-wrap:wrap;margin-bottom:20px}
.footer-links a{font-size:13px;color:rgba(255,255,255,.5);text-decoration:none}
.footer-links a:hover{color:#fff}
.footer-bottom{font-size:12px;color:rgba(255,255,255,.25);border-top:1px solid rgba(255,255,255,.07);padding-top:16px}

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .hero-inner{grid-template-columns:1fr;gap:36px}
  .hero-form{max-width:540px;margin:0 auto;width:100%}
  .trust-grid{grid-template-columns:repeat(2,1fr)}
  .gallery-grid{grid-template-columns:repeat(3,1fr)}
  .infra-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:768px){
  .ubar{font-size:11.5px;padding:9px 12px;flex-wrap:wrap;gap:5px;line-height:1.5;position:sticky;top:0}
  .ubar-tag{font-size:10px}
  .nav{top:0!important;height:60px;padding:0 14px}
  .nav-logo img{height:40px;max-width:170px}
  section{padding:48px 14px}
  .hero{padding:28px 14px 40px;min-height:auto;background-color:#050D2E;background-image:linear-gradient(160deg,#050D2E 0%,#1847C2 55%,#6C3DE8 100%)}
  .hero-eyebrow{font-size:11.5px;padding:5px 12px;margin-bottom:14px}
  .hero-h1{font-size:28px;letter-spacing:-.02em;margin-bottom:10px}
  .hero-h1 br{display:none}
  .hero-h2{font-size:14.5px;margin-bottom:12px}
  .hero-desc{font-size:14px;margin-bottom:18px}
  .hero-usps{gap:8px;margin-bottom:22px}
  .hero-usp{font-size:13px}
  .hero-usp-icon{width:26px;height:26px;font-size:13px;flex-shrink:0}
  .hero-ctas{flex-direction:column;gap:10px}
  .hero-ctas .btn{width:100%;justify-content:center;padding:14px 16px;font-size:14px}
  .hero-form{padding:20px 16px;border-radius:18px;max-width:100%}
  .form-h{font-size:17px}
  .form-sub{font-size:12px;margin-bottom:12px}
  .scarcity{font-size:11.5px;padding:7px 10px}
  .fgroup{margin-bottom:10px}
  .fgroup label{font-size:12px}
  .fgroup input,.fgroup select{font-size:16px;padding:12px 14px}
  .btn-orange{padding:13px;font-size:14px}
  .stats-bar{padding:16px}
  .stats-inner{display:grid;grid-template-columns:1fr 1fr;gap:14px;justify-items:center}
  .stat-sep{display:none}
  .stat-num{font-size:22px}
  .stat-lbl{font-size:11px}
  .usp-strip-sec{padding:20px 14px}
  .usp-chip{font-size:12px;padding:7px 13px}
  .how-grid{grid-template-columns:1fr;gap:0}
  .how-grid::before{display:none}
  .how-step{padding:28px 16px}
  .how-step:not(:last-child){border-bottom:1px solid var(--border)}
  .how-circle{width:76px;height:76px}
  .how-circle-emoji{font-size:28px}
  .how-title{font-size:16px}
  .infra-grid{grid-template-columns:1fr}
